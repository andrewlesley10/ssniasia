# Don't serve a browsable index of any directory that lacks an index file
Options -Indexes

# MultiViews content negotiation fights with the extensionless-URL rewrites
# below (it can answer /about itself, with no proper Content-Type).
Options -MultiViews

# Always serve the homepage at "/" and always label pages as HTML. Combined
# with the nosniff header further down, a page sent without a text/html type
# is offered as a file download on phones instead of being displayed.
DirectoryIndex index.html
AddType text/html .html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ——— Force HTTPS + www ————————————————————————————————————————————
  # The site's identity is www.ssniasia.com, so the bare domain is sent there.
  # Both HTTPS conditions are needed: %{HTTPS} is the direct-TLS case, and
  # X-Forwarded-Proto covers hosts that terminate TLS at a load balancer —
  # where %{HTTPS} reads "off" even on an HTTPS request, and checking it
  # alone would produce an infinite redirect loop.
  RewriteCond %{HTTP_HOST} ^ssniasia\.com$ [NC]
  RewriteRule ^(.*)$ https://www.ssniasia.com/$1 [R=301,L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # The homepage lives at "/" only. Send old /home, /index and /index.html
  # links there. Matching THE_REQUEST (what the visitor actually asked for)
  # rather than the URL means the internal DirectoryIndex lookup of
  # index.html for "/" doesn't trigger this rule and loop.
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /+(home|index)(\.html)?[\ ?] [NC]
  RewriteRule ^ / [R=301,L]

  # Redirect .html to the extensionless version
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html
  RewriteRule ^([^\.]+)\.html$ /$1 [R=301,L]

  # Redirect .php to the extensionless version (GET only — never strip POST data)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.php
  RewriteCond %{REQUEST_METHOD} !POST
  RewriteRule ^([^\.]+)\.php$ /$1 [R=301,L]

  # Rewrite extensionless GET requests to the .html file
  RewriteCond %{REQUEST_METHOD} !POST
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]

  # Rewrite extensionless POST requests to the .php file
  RewriteCond %{REQUEST_METHOD} ^POST$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^\.]+)$ $1.php [NC,L]
</IfModule>

# ——— Caching ——————————————————————————————————————————————————————
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>

# ——— Security headers ————————————————————————————————————————————————
<IfModule mod_headers.c>
  # Don't let browsers guess a file's type against its declared one
  Header always set X-Content-Type-Options "nosniff"
  # Trim what leaks in the Referer header on outbound links
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Clickjacking: only this origin may frame the site
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # Content Security Policy. 'unsafe-inline' is required on both script and
  # style: the preloader bootstrap is an inline <script> in every <head> (it
  # has to run before paint), and the pages use inline style="" attributes.
  # Everything else is locked to this origin plus the third parties actually
  # in use: Google Fonts and the Google Maps embed on the contact page.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src https://www.google.com https://maps.google.com; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'"

  # HSTS — browsers refuse plain HTTP for this domain for the max-age window.
  # Rolled out in stages on purpose: a long max-age CANNOT be undone quickly,
  # so if the certificate later lapses the site is unreachable for anyone who
  # has visited before. Starting at 1 day keeps the blast radius to 24 hours.
  #
  # Once HTTPS has been confirmed stable on the live domain for a week or two,
  # raise this to the full two years by swapping the max-age below for
  # 63072000 (and only then consider adding `preload`).
  Header always set Strict-Transport-Security "max-age=86400; includeSubDomains"
</IfModule>

# Never serve raw log/config files or the original logo source if any end up here
<FilesMatch "\.(env|ini|log|sh|sql|bak|md)$">
  Require all denied
</FilesMatch>
